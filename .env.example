# Copy this file to `.env`, fill in real values, then run:  source .env
# `.env` is gitignored so your secrets never get committed.

# Required: bearer token for your Tyr assistant's MCP server.
export TYR_MCP_TOKEN=paste_your_tyr_token_here

# Required: OpenRouter API key for the Loop Agent's own model calls.
export OPENROUTER_API_KEY=paste_your_openrouter_key_here

# Optional overrides (uncomment to change from defaults):
# export TYR_LOOP_MODEL=anthropic/claude-sonnet-5
# export TYR_LOOP_ALLOW_ACTIONS=true
# export TYR_LOOP_EXPLORE_TURNS=10
# export TYR_LOOP_MAX_TURNS=150
# export TYR_MCP_URL=https://www.tyr.ai/tyrcli/mcp
