# Copy to .env and fill secrets for live Tyr/model runs:
#   cp .env.example .env
# Then either:
#   uv run poe dev
#   docker compose up -d --build

GAMR_ENVIRONMENT=development
GAMR_ARTIFACT_ROOT=.gamr
GAMR_DATASET_ROOT=datasets

# Browser-facing origins (API CORS uses GAMR_WEB_ORIGIN).
# localhost and 127.0.0.1 are both accepted when either is set.
GAMR_API_ORIGIN=http://127.0.0.1:6687
GAMR_WEB_ORIGIN=http://127.0.0.1:6688

GAMR_TYR_MCP_URL=https://www.tyr.ai/tyrcli/mcp
GAMR_TYR_MCP_TOKEN=
GAMR_MODEL_BASE_URL=https://openrouter.ai/api/v1
GAMR_MODEL_API_KEY=
GAMR_MODEL_NAME=
GAMR_MAX_CONCURRENT_RUNS=3

# Docker only: baked into the web image at build time (browser → API).
# Rebuild web after changing: docker compose up -d --build web
# VITE_API_ORIGIN=http://127.0.0.1:6687
