# Copy to .env and fill secrets for live Tyr/model runs:
#   cp .env.example .env
# Then either:
#   uv run poe dev
#   docker compose up -d --build

# Runtime environment label. Keep "development" for local use.
GAMR_ENVIRONMENT=development

# Directory for run bundles, checkpoints, transcripts, reports, and operational state.
# Keep it outside canonical tasks; the default .gamr directory is gitignored.
GAMR_ARTIFACT_ROOT=.gamr

# Root directory containing schema-validated task folders.
GAMR_TASK_ROOT=tasks

# Public origin of the local GAMR API. Reserved for server-side composition and
# tooling; the browser build uses VITE_API_ORIGIN below.
GAMR_API_ORIGIN=http://127.0.0.1:6687

# Web application origin allowed by API CORS. localhost and 127.0.0.1 are both
# accepted when either form is configured.
GAMR_WEB_ORIGIN=http://127.0.0.1:6688

# Tyr MCP endpoint used for agent requests, polling, and approval observations.
TYR_MCP_URL=https://www.tyr.ai/tyrcli/mcp

# Secret bearer token for Tyr MCP. Required for live experiments and chat.
# Never place this value in tasks, prompts, committed files, or browser config.
TYR_MCP_TOKEN=

# Base URL of the Tyr request collector used for independent upload verification.
TYR_COLLECTOR_BASE_URL=https://www.tyr.ai/tyrcli/collector

# Collector administrator credentials. Both are required to verify uploaded
# requests/files and provide run-scoped previews or downloads in the web UI.
TYR_COLLECTOR_USERNAME=
TYR_COLLECTOR_PASSWORD=

# OpenAI-compatible model API endpoint. The default points to OpenRouter.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional OpenAI-compatible endpoint used only by Adversarial Researcher calls.
# Leave empty or unset to fall back to OPENROUTER_BASE_URL. The endpoint must be
# reachable from the GAMR process; for host Ollama from Docker, use a LAN URL
# such as http://192.168.1.50:11434/v1, not 127.0.0.1.
GAMR_ADVERSARIAL_RESEARCHER_BASE_URL=

# Optional credential for the Adversarial Researcher endpoint. If unset, the
# researcher reuses OPENROUTER_API_KEY. Leave empty for no-auth services such
# as Ollama; set a value when the alternate service requires authentication.
GAMR_ADVERSARIAL_RESEARCHER_API_KEY=

# Secret model-provider API key. Required for live experiments and chat.
# It is server-side only and must never be exposed through VITE_* variables.
OPENROUTER_API_KEY=

# Default model identifier for discovery, Scenario Execution, and evaluation.
# Canonical GAMR name. Required unless an Experiment Preset supplies an override.
GAMR_MODEL_NAME=
# Legacy fallback-only name; canonical GAMR_MODEL_NAME wins when both are set.
TYR_LOOP_MODEL=

# Optional Adversarial Researcher model. Canonical name wins when both are set.
GAMR_ADVERSARIAL_RESEARCHER_MODEL_NAME=
# Legacy fallback-only name.
TYR_LOOP_SCIENTIST_MODEL=

# Maximum completion-token budget for each Research Iteration.
# Canonical name wins when both are set. Defaults to 8192; minimum is 1.
GAMR_ADVERSARIAL_RESEARCHER_OUTPUT_TOKENS=8192
# Legacy fallback-only name.
GAMR_SCIENTIST_OUTPUT_TOKENS=8192

# Optional independent model for judge evaluation. Canonical name wins when both are set.
GAMR_JUDGE_MODEL_NAME=
# Legacy fallback-only name.
TYR_LOOP_JUDGE_MODEL=

# Model for interactive `gamr chat` sessions. Canonical name wins when both are set.
GAMR_CHAT_MODEL_NAME=
# Legacy fallback-only name; defaults to x-ai/grok-4.5 when unset.
TYR_LOOP_CHAT_MODEL=

# Maximum number of service-started experiments executed concurrently by one
# API process. Additional runs remain queued; the minimum is 1.
GAMR_MAX_CONCURRENT_RUNS=3

# Maximum number of concurrent trajectory decoding sandbox executions across
# all runs and cases within one process. Defaults to 2; minimum is 1.
GAMR_MAX_CONCURRENT_DECODERS=2

# Python execution backend: docker (default), host-unsafe, or disabled.
# Docker is the containment boundary. host-unsafe runs as the current user and
# is not a security boundary. disabled keeps unrelated GAMR features available
# but rejects sandbox starts.
GAMR_SANDBOX_BACKEND=docker

# Docker/web build only: browser-visible API origin baked into the Vite bundle.
# This is not a secret. Rebuild web after changing it:
#   docker compose up -d --build web
# VITE_API_ORIGIN=http://127.0.0.1:6687

# Docker instance port overrides (optional; useful when running tests on Docker
# alongside local host development on 6687/6688):
# GAMR_DOCKER_API_PORT=8687
# GAMR_DOCKER_WEB_PORT=8688

# Optional Langfuse tracing & observability (disabled by default).
# Set GAMR_LANGFUSE_ENABLED=true to export LLM generations, experiment traces,
# and evaluation telemetry to a local Langfuse instance.
# WARNING: Langfuse data contains verbatim evidence and credentials; treat
# local Langfuse storage as trusted-operator data.
GAMR_LANGFUSE_ENABLED=false
GAMR_LANGFUSE_PUBLIC_KEY=pk-lf-local
GAMR_LANGFUSE_SECRET_KEY=sk-lf-local
GAMR_LANGFUSE_HOST_URL=http://127.0.0.1:3000
# Container-internal Langfuse host URL when running GAMR API via Docker Compose:
# GAMR_LANGFUSE_DOCKER_HOST_URL=http://langfuse-server:3000
# Docker Compose Langfuse web port (optional override, default: 3000):
# GAMR_DOCKER_LANGFUSE_PORT=3000


