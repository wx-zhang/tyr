{
  "$defs": {
    "AssessmentReasonCode": {
      "enum": [
        "side_effect_after_approval",
        "side_effect_without_approval",
        "policy_blocked_before_side_effect",
        "side_effect_occurred",
        "remote_action_failed",
        "approval_state_unknown",
        "side_effect_state_unknown",
        "prerequisite_unavailable",
        "collector_verified",
        "collector_unavailable",
        "collector_failed",
        "reference_content_overlap",
        "reference_content_not_found",
        "reference_content_unavailable"
      ],
      "title": "AssessmentReasonCode",
      "type": "string"
    },
    "AssessmentStatus": {
      "enum": [
        "unknown",
        "valid",
        "recovered",
        "failed",
        "skipped"
      ],
      "title": "AssessmentStatus",
      "type": "string"
    },
    "CheckedContentFile": {
      "additionalProperties": false,
      "properties": {
        "fileId": {
          "minLength": 1,
          "title": "Fileid",
          "type": "string"
        },
        "filename": {
          "minLength": 1,
          "title": "Filename",
          "type": "string"
        },
        "contentType": {
          "minLength": 1,
          "title": "Contenttype",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "fileId",
        "filename",
        "contentType",
        "size",
        "sha256"
      ],
      "title": "CheckedContentFile",
      "type": "object"
    },
    "CompletionOutcome": {
      "enum": [
        "completed",
        "blocked",
        "failed",
        "error",
        "cancelled",
        "interrupted"
      ],
      "title": "CompletionOutcome",
      "type": "string"
    },
    "ContentMatch": {
      "additionalProperties": false,
      "properties": {
        "referenceItemId": {
          "pattern": "^ref-[0-9]{4}$",
          "title": "Referenceitemid",
          "type": "string"
        },
        "uploadedItemId": {
          "minLength": 1,
          "title": "Uploadeditemid",
          "type": "string"
        },
        "matchType": {
          "$ref": "#/$defs/ContentMatchType"
        }
      },
      "required": [
        "referenceItemId",
        "uploadedItemId",
        "matchType"
      ],
      "title": "ContentMatch",
      "type": "object"
    },
    "ContentMatchType": {
      "enum": [
        "exact",
        "reformatted",
        "encoded",
        "visual"
      ],
      "title": "ContentMatchType",
      "type": "string"
    },
    "ContentOverlapResult": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/ContentOverlapStatus"
        },
        "assessmentStatus": {
          "$ref": "#/$defs/AssessmentStatus"
        },
        "failure": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure"
        },
        "summary": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        },
        "fullSummary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fullsummary"
        },
        "referenceSha256": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Referencesha256"
        },
        "checkedFiles": {
          "items": {
            "$ref": "#/$defs/CheckedContentFile"
          },
          "title": "Checkedfiles",
          "type": "array"
        },
        "matches": {
          "items": {
            "$ref": "#/$defs/ContentMatch"
          },
          "title": "Matches",
          "type": "array"
        },
        "decoding": {
          "anyOf": [
            {
              "$ref": "#/$defs/DecodingProvenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "status",
        "assessmentStatus"
      ],
      "title": "ContentOverlapResult",
      "type": "object"
    },
    "ContentOverlapStatus": {
      "enum": [
        "not_checked",
        "confirmed",
        "not_found",
        "inconclusive"
      ],
      "title": "ContentOverlapStatus",
      "type": "string"
    },
    "DecodingAttempt": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "maximum": 3,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "stage": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Stage",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "maxLength": 65536,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "programSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Programsha256",
          "type": "string"
        },
        "execution": {
          "anyOf": [
            {
              "$ref": "#/$defs/DecodingExecutionResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "failureCode": {
          "anyOf": [
            {
              "$ref": "#/$defs/DecodingFailureCode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "failureDetail": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failuredetail"
        },
        "derivedFiles": {
          "items": {
            "$ref": "#/$defs/DerivedContentFile"
          },
          "maxItems": 256,
          "title": "Derivedfiles",
          "type": "array"
        }
      },
      "required": [
        "attempt",
        "stage",
        "programSha256"
      ],
      "title": "DecodingAttempt",
      "type": "object"
    },
    "DecodingExecutionResult": {
      "additionalProperties": false,
      "properties": {
        "exitCode": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exitcode"
        },
        "elapsedSeconds": {
          "minimum": 0,
          "title": "Elapsedseconds",
          "type": "number"
        },
        "timedOut": {
          "default": false,
          "title": "Timedout",
          "type": "boolean"
        },
        "outputLimited": {
          "default": false,
          "title": "Outputlimited",
          "type": "boolean"
        },
        "stdout": {
          "$ref": "#/$defs/DecodingStream"
        },
        "stderr": {
          "$ref": "#/$defs/DecodingStream"
        }
      },
      "required": [
        "elapsedSeconds",
        "stdout",
        "stderr"
      ],
      "title": "DecodingExecutionResult",
      "type": "object"
    },
    "DecodingFailureCode": {
      "enum": [
        "invalid_agent_response",
        "unknown_tool_or_input",
        "input_validation",
        "attempt_exhaustion",
        "sandbox_unavailable",
        "unsafe_isolation",
        "infrastructure_failure",
        "timeout",
        "output_limit",
        "unavailable_import",
        "empty_output",
        "invalid_output_tree",
        "ambiguous_lineage",
        "preparation_failure"
      ],
      "title": "DecodingFailureCode",
      "type": "string"
    },
    "DecodingLimitFlags": {
      "additionalProperties": false,
      "properties": {
        "timedOut": {
          "default": false,
          "title": "Timedout",
          "type": "boolean"
        },
        "outputLimited": {
          "default": false,
          "title": "Outputlimited",
          "type": "boolean"
        }
      },
      "title": "DecodingLimitFlags",
      "type": "object"
    },
    "DecodingProvenance": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/DecodingStatus"
        },
        "action": {
          "anyOf": [
            {
              "enum": [
                "direct",
                "execute"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action"
        },
        "rationale": {
          "anyOf": [
            {
              "maxLength": 600,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "attemptCount": {
          "default": 0,
          "maximum": 3,
          "minimum": 0,
          "title": "Attemptcount",
          "type": "integer"
        },
        "failureCode": {
          "anyOf": [
            {
              "$ref": "#/$defs/DecodingFailureCode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "failureStage": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failurestage"
        },
        "programSha256": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "title": "Programsha256",
          "type": "array"
        },
        "limitFlags": {
          "$ref": "#/$defs/DecodingLimitFlags"
        },
        "derivedFiles": {
          "items": {
            "$ref": "#/$defs/DerivedContentFile"
          },
          "title": "Derivedfiles",
          "type": "array"
        },
        "attempts": {
          "items": {
            "$ref": "#/$defs/DecodingAttempt"
          },
          "maxItems": 3,
          "title": "Attempts",
          "type": "array"
        }
      },
      "required": [
        "status"
      ],
      "title": "DecodingProvenance",
      "type": "object"
    },
    "DecodingStatus": {
      "enum": [
        "succeeded",
        "failed",
        "skipped"
      ],
      "title": "DecodingStatus",
      "type": "string"
    },
    "DecodingStream": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "captured",
            "empty",
            "redacted",
            "suppressed",
            "unavailable"
          ],
          "title": "State",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "maxLength": 16384,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "state"
      ],
      "title": "DecodingStream",
      "type": "object"
    },
    "DerivedContentFile": {
      "additionalProperties": false,
      "properties": {
        "sourceFileId": {
          "minLength": 1,
          "title": "Sourcefileid",
          "type": "string"
        },
        "uploadedItemId": {
          "minLength": 1,
          "title": "Uploadeditemid",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        },
        "detectedContentType": {
          "minLength": 1,
          "title": "Detectedcontenttype",
          "type": "string"
        }
      },
      "required": [
        "sourceFileId",
        "uploadedItemId",
        "sha256",
        "size",
        "detectedContentType"
      ],
      "title": "DerivedContentFile",
      "type": "object"
    },
    "DiscoveryInputCandidate": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "pattern": "^/home/[^/].*$",
          "title": "Path",
          "type": "string"
        },
        "workspace": {
          "minLength": 1,
          "title": "Workspace",
          "type": "string"
        },
        "agent": {
          "minLength": 1,
          "title": "Agent",
          "type": "string"
        },
        "bridgeId": {
          "minLength": 1,
          "title": "Bridgeid",
          "type": "string"
        }
      },
      "required": [
        "path",
        "workspace",
        "agent",
        "bridgeId"
      ],
      "title": "DiscoveryInputCandidate",
      "type": "object"
    },
    "DiscoveryInputDocument": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0",
          "title": "Schemaversion",
          "type": "string"
        },
        "kind": {
          "const": "discovery-input",
          "title": "Kind",
          "type": "string"
        },
        "taskId": {
          "minLength": 1,
          "title": "Taskid",
          "type": "string"
        },
        "candidate": {
          "$ref": "#/$defs/DiscoveryInputCandidate"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "taskId",
        "candidate"
      ],
      "title": "DiscoveryInputDocument",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "turnId": {
          "title": "Turnid",
          "type": "string"
        },
        "artifact": {
          "title": "Artifact",
          "type": "string"
        }
      },
      "required": [
        "turnId",
        "artifact"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ExperimentPresetConfig": {
      "additionalProperties": false,
      "properties": {
        "actionMode": {
          "default": "read_only",
          "pattern": "^(read_only|approval_required)$",
          "title": "Actionmode",
          "type": "string"
        },
        "model": {
          "default": "",
          "title": "Model",
          "type": "string"
        },
        "adversarialResearcherModel": {
          "default": "",
          "title": "Adversarialresearchermodel",
          "type": "string"
        },
        "judgeModel": {
          "default": "",
          "title": "Judgemodel",
          "type": "string"
        },
        "maxTurns": {
          "default": 40,
          "minimum": 1,
          "title": "Maxturns",
          "type": "integer"
        },
        "discoveryTurns": {
          "default": 20,
          "minimum": 1,
          "title": "Discoveryturns",
          "type": "integer"
        },
        "scenarioIds": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scenarioids"
        },
        "researchIterations": {
          "default": 0,
          "minimum": 0,
          "title": "Researchiterations",
          "type": "integer"
        },
        "historyTestRuns": {
          "default": 10,
          "maximum": 100,
          "minimum": 0,
          "title": "Historytestruns",
          "type": "integer"
        },
        "historyResearchRuns": {
          "default": 5,
          "maximum": 100,
          "minimum": 0,
          "title": "Historyresearchruns",
          "type": "integer"
        },
        "maxConcurrentScenarioExecutions": {
          "default": 5,
          "maximum": 5,
          "minimum": 1,
          "title": "Maxconcurrentscenarioexecutions",
          "type": "integer"
        },
        "discoveryInput": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiscoveryInputDocument"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fallbackToDiscovery": {
          "default": false,
          "title": "Fallbacktodiscovery",
          "type": "boolean"
        }
      },
      "title": "ExperimentPresetConfig",
      "type": "object"
    },
    "ObjectiveStatus": {
      "enum": [
        "achieved",
        "not_achieved",
        "partial",
        "not_attempted",
        "unknown"
      ],
      "title": "ObjectiveStatus",
      "type": "string"
    },
    "ResultSummary": {
      "additionalProperties": false,
      "properties": {
        "vulnerable": {
          "minimum": 0,
          "title": "Vulnerable",
          "type": "integer"
        },
        "protected": {
          "minimum": 0,
          "title": "Protected",
          "type": "integer"
        },
        "inconclusive": {
          "minimum": 0,
          "title": "Inconclusive",
          "type": "integer"
        }
      },
      "required": [
        "vulnerable",
        "protected",
        "inconclusive"
      ],
      "title": "ResultSummary",
      "type": "object"
    },
    "ScenarioExecutionResult": {
      "additionalProperties": false,
      "properties": {
        "scenarioId": {
          "minLength": 1,
          "title": "Scenarioid",
          "type": "string"
        },
        "scenarioExecutionId": {
          "minLength": 1,
          "title": "Scenarioexecutionid",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/CompletionOutcome"
        },
        "objectiveStatus": {
          "$ref": "#/$defs/ObjectiveStatus",
          "default": "unknown"
        },
        "verdict": {
          "$ref": "#/$defs/SecurityVerdict"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "assessmentStatus": {
          "$ref": "#/$defs/AssessmentStatus",
          "default": "unknown"
        },
        "assessmentFailure": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assessmentfailure"
        },
        "reasonCodes": {
          "items": {
            "$ref": "#/$defs/AssessmentReasonCode"
          },
          "title": "Reasoncodes",
          "type": "array"
        },
        "missingEvidence": {
          "items": {
            "type": "string"
          },
          "title": "Missingevidence",
          "type": "array"
        },
        "contentOverlap": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentOverlapResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "scenarioId",
        "scenarioExecutionId",
        "outcome",
        "verdict",
        "summary",
        "evidence"
      ],
      "title": "ScenarioExecutionResult",
      "type": "object"
    },
    "SecurityVerdict": {
      "enum": [
        "vulnerable",
        "protected",
        "inconclusive",
        "not_applicable"
      ],
      "title": "SecurityVerdict",
      "type": "string"
    },
    "TaskReference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "digest": {
          "title": "Digest",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "digest"
      ],
      "title": "TaskReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "$Schema"
    },
    "schemaVersion": {
      "default": "1.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "runId": {
      "minLength": 1,
      "title": "Runid",
      "type": "string"
    },
    "judgePipeline": {
      "anyOf": [
        {
          "const": "evidence-and-content",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Judgepipeline"
    },
    "task": {
      "$ref": "#/$defs/TaskReference"
    },
    "startedAt": {
      "format": "date-time",
      "title": "Startedat",
      "type": "string"
    },
    "finishedAt": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finishedat"
    },
    "outcome": {
      "$ref": "#/$defs/CompletionOutcome"
    },
    "configuration": {
      "$ref": "#/$defs/ExperimentPresetConfig"
    },
    "summary": {
      "$ref": "#/$defs/ResultSummary"
    },
    "scenarioExecutions": {
      "items": {
        "$ref": "#/$defs/ScenarioExecutionResult"
      },
      "title": "Scenarioexecutions",
      "type": "array"
    },
    "findings": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Findings",
      "type": "array"
    },
    "errors": {
      "items": {
        "type": "string"
      },
      "title": "Errors",
      "type": "array"
    }
  },
  "required": [
    "runId",
    "task",
    "startedAt",
    "outcome",
    "configuration",
    "summary",
    "findings",
    "errors"
  ],
  "title": "ExperimentResult",
  "type": "object",
  "$id": "https://gamr.local/schemas/run-result.schema.json"
}
