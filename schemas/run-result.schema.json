{
  "$defs": {
    "AssessmentReasonCode": {
      "enum": [
        "side_effect_after_approval",
        "side_effect_without_approval",
        "policy_blocked_before_side_effect",
        "side_effect_occurred",
        "remote_action_failed",
        "approval_state_unknown",
        "side_effect_state_unknown",
        "prerequisite_unavailable",
        "collector_verified",
        "collector_unavailable",
        "collector_failed",
        "reference_content_overlap",
        "reference_content_not_found",
        "reference_content_unavailable"
      ],
      "title": "AssessmentReasonCode",
      "type": "string"
    },
    "AssessmentStatus": {
      "enum": [
        "unknown",
        "valid",
        "recovered",
        "failed",
        "skipped"
      ],
      "title": "AssessmentStatus",
      "type": "string"
    },
    "CaseResult": {
      "additionalProperties": false,
      "properties": {
        "scenarioId": {
          "title": "Scenarioid",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/ExecutionOutcome"
        },
        "objectiveStatus": {
          "$ref": "#/$defs/ObjectiveStatus",
          "default": "unknown"
        },
        "verdict": {
          "$ref": "#/$defs/SecurityVerdict"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "assessmentStatus": {
          "$ref": "#/$defs/AssessmentStatus",
          "default": "unknown"
        },
        "assessmentFailure": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assessmentfailure"
        },
        "reasonCodes": {
          "items": {
            "$ref": "#/$defs/AssessmentReasonCode"
          },
          "title": "Reasoncodes",
          "type": "array"
        },
        "missingEvidence": {
          "items": {
            "type": "string"
          },
          "title": "Missingevidence",
          "type": "array"
        },
        "contentOverlap": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentOverlapResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "scenarioId",
        "outcome",
        "verdict",
        "summary",
        "evidence"
      ],
      "title": "CaseResult",
      "type": "object"
    },
    "CheckedContentFile": {
      "additionalProperties": false,
      "properties": {
        "fileId": {
          "minLength": 1,
          "title": "Fileid",
          "type": "string"
        },
        "filename": {
          "minLength": 1,
          "title": "Filename",
          "type": "string"
        },
        "contentType": {
          "minLength": 1,
          "title": "Contenttype",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "fileId",
        "filename",
        "contentType",
        "size",
        "sha256"
      ],
      "title": "CheckedContentFile",
      "type": "object"
    },
    "ContentMatch": {
      "additionalProperties": false,
      "properties": {
        "referenceItemId": {
          "pattern": "^ref-[0-9]{4}$",
          "title": "Referenceitemid",
          "type": "string"
        },
        "uploadedItemId": {
          "minLength": 1,
          "title": "Uploadeditemid",
          "type": "string"
        },
        "matchType": {
          "$ref": "#/$defs/ContentMatchType"
        }
      },
      "required": [
        "referenceItemId",
        "uploadedItemId",
        "matchType"
      ],
      "title": "ContentMatch",
      "type": "object"
    },
    "ContentMatchType": {
      "enum": [
        "exact",
        "reformatted",
        "encoded",
        "visual"
      ],
      "title": "ContentMatchType",
      "type": "string"
    },
    "ContentOverlapResult": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/ContentOverlapStatus"
        },
        "assessmentStatus": {
          "$ref": "#/$defs/AssessmentStatus"
        },
        "failure": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure"
        },
        "summary": {
          "anyOf": [
            {
              "maxLength": 600,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        },
        "fullSummary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fullsummary"
        },
        "referenceSha256": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Referencesha256"
        },
        "checkedFiles": {
          "items": {
            "$ref": "#/$defs/CheckedContentFile"
          },
          "title": "Checkedfiles",
          "type": "array"
        },
        "matches": {
          "items": {
            "$ref": "#/$defs/ContentMatch"
          },
          "title": "Matches",
          "type": "array"
        }
      },
      "required": [
        "status",
        "assessmentStatus"
      ],
      "title": "ContentOverlapResult",
      "type": "object"
    },
    "ContentOverlapStatus": {
      "enum": [
        "not_checked",
        "confirmed",
        "not_found",
        "inconclusive"
      ],
      "title": "ContentOverlapStatus",
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "turnId": {
          "title": "Turnid",
          "type": "string"
        },
        "artifact": {
          "title": "Artifact",
          "type": "string"
        }
      },
      "required": [
        "turnId",
        "artifact"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ExecutionOutcome": {
      "enum": [
        "completed",
        "blocked",
        "failed",
        "error",
        "cancelled",
        "interrupted"
      ],
      "title": "ExecutionOutcome",
      "type": "string"
    },
    "ExperimentConfig": {
      "additionalProperties": false,
      "properties": {
        "actionMode": {
          "default": "read_only",
          "pattern": "^(read_only|approval_required)$",
          "title": "Actionmode",
          "type": "string"
        },
        "model": {
          "default": "",
          "title": "Model",
          "type": "string"
        },
        "scientistModel": {
          "default": "",
          "title": "Scientistmodel",
          "type": "string"
        },
        "judgeModel": {
          "default": "",
          "title": "Judgemodel",
          "type": "string"
        },
        "maxTurns": {
          "default": 40,
          "minimum": 1,
          "title": "Maxturns",
          "type": "integer"
        },
        "discoveryTurns": {
          "default": 20,
          "minimum": 1,
          "title": "Discoveryturns",
          "type": "integer"
        },
        "caseIds": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caseids"
        },
        "scientistIterations": {
          "default": 0,
          "minimum": 0,
          "title": "Scientistiterations",
          "type": "integer"
        },
        "historyTestRuns": {
          "default": 10,
          "maximum": 100,
          "minimum": 0,
          "title": "Historytestruns",
          "type": "integer"
        },
        "historyScientistRuns": {
          "default": 5,
          "maximum": 100,
          "minimum": 0,
          "title": "Historyscientistruns",
          "type": "integer"
        },
        "maxConcurrentCases": {
          "default": 5,
          "maximum": 5,
          "minimum": 1,
          "title": "Maxconcurrentcases",
          "type": "integer"
        }
      },
      "title": "ExperimentConfig",
      "type": "object"
    },
    "ObjectiveStatus": {
      "enum": [
        "achieved",
        "not_achieved",
        "partial",
        "not_attempted",
        "unknown"
      ],
      "title": "ObjectiveStatus",
      "type": "string"
    },
    "ResultSummary": {
      "additionalProperties": false,
      "properties": {
        "vulnerable": {
          "minimum": 0,
          "title": "Vulnerable",
          "type": "integer"
        },
        "protected": {
          "minimum": 0,
          "title": "Protected",
          "type": "integer"
        },
        "inconclusive": {
          "minimum": 0,
          "title": "Inconclusive",
          "type": "integer"
        }
      },
      "required": [
        "vulnerable",
        "protected",
        "inconclusive"
      ],
      "title": "ResultSummary",
      "type": "object"
    },
    "SecurityVerdict": {
      "enum": [
        "vulnerable",
        "protected",
        "inconclusive",
        "not_applicable"
      ],
      "title": "SecurityVerdict",
      "type": "string"
    },
    "TaskReference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "digest": {
          "title": "Digest",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "digest"
      ],
      "title": "TaskReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "$Schema"
    },
    "schemaVersion": {
      "default": "1.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "runId": {
      "title": "Runid",
      "type": "string"
    },
    "judgePipeline": {
      "anyOf": [
        {
          "const": "evidence-and-content",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Judgepipeline"
    },
    "task": {
      "$ref": "#/$defs/TaskReference"
    },
    "startedAt": {
      "format": "date-time",
      "title": "Startedat",
      "type": "string"
    },
    "finishedAt": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finishedat"
    },
    "outcome": {
      "$ref": "#/$defs/ExecutionOutcome"
    },
    "configuration": {
      "$ref": "#/$defs/ExperimentConfig"
    },
    "summary": {
      "$ref": "#/$defs/ResultSummary"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/CaseResult"
      },
      "title": "Cases",
      "type": "array"
    },
    "findings": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Findings",
      "type": "array"
    },
    "errors": {
      "items": {
        "type": "string"
      },
      "title": "Errors",
      "type": "array"
    }
  },
  "required": [
    "runId",
    "task",
    "startedAt",
    "outcome",
    "configuration",
    "summary",
    "cases",
    "findings",
    "errors"
  ],
  "title": "RunResult",
  "type": "object",
  "$id": "https://gamr.local/schemas/run-result.schema.json"
}
