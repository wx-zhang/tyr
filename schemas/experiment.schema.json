{
  "$defs": {
    "DiscoveryInputCandidate": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "workspace": {
          "minLength": 1,
          "title": "Workspace",
          "type": "string"
        },
        "agent": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent"
        },
        "bridgeId": {
          "minLength": 1,
          "title": "Bridgeid",
          "type": "string"
        }
      },
      "required": [
        "workspace",
        "bridgeId"
      ],
      "title": "DiscoveryInputCandidate",
      "type": "object"
    },
    "DiscoveryInputDocument": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0",
          "title": "Schemaversion",
          "type": "string"
        },
        "kind": {
          "const": "discovery-input",
          "title": "Kind",
          "type": "string"
        },
        "taskId": {
          "minLength": 1,
          "title": "Taskid",
          "type": "string"
        },
        "candidate": {
          "$ref": "#/$defs/DiscoveryInputCandidate"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "taskId",
        "candidate"
      ],
      "title": "DiscoveryInputDocument",
      "type": "object"
    },
    "ExperimentPresetConfig": {
      "additionalProperties": false,
      "properties": {
        "actionMode": {
          "default": "read_only",
          "pattern": "^(read_only|approval_required)$",
          "title": "Actionmode",
          "type": "string"
        },
        "model": {
          "default": "",
          "title": "Model",
          "type": "string"
        },
        "adversarialResearcherModel": {
          "default": "",
          "title": "Adversarialresearchermodel",
          "type": "string"
        },
        "judgeModel": {
          "default": "",
          "title": "Judgemodel",
          "type": "string"
        },
        "maxTurns": {
          "default": 40,
          "minimum": 1,
          "title": "Maxturns",
          "type": "integer"
        },
        "discoveryTurns": {
          "default": 20,
          "minimum": 1,
          "title": "Discoveryturns",
          "type": "integer"
        },
        "scenarioIds": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scenarioids"
        },
        "researchIterations": {
          "default": 0,
          "minimum": 0,
          "title": "Researchiterations",
          "type": "integer"
        },
        "historyTestRuns": {
          "default": 10,
          "maximum": 100,
          "minimum": 0,
          "title": "Historytestruns",
          "type": "integer"
        },
        "historyResearchRuns": {
          "default": 5,
          "maximum": 100,
          "minimum": 0,
          "title": "Historyresearchruns",
          "type": "integer"
        },
        "maxConcurrentScenarioExecutions": {
          "default": 5,
          "maximum": 5,
          "minimum": 1,
          "title": "Maxconcurrentscenarioexecutions",
          "type": "integer"
        },
        "discoveryInput": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiscoveryInputDocument"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fallbackToDiscovery": {
          "default": false,
          "title": "Fallbacktodiscovery",
          "type": "boolean"
        }
      },
      "title": "ExperimentPresetConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "default": "1.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "task": {
      "minLength": 1,
      "title": "Task",
      "type": "string"
    },
    "configuration": {
      "$ref": "#/$defs/ExperimentPresetConfig"
    },
    "createdAt": {
      "format": "date-time",
      "title": "Createdat",
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "task",
    "createdAt"
  ],
  "title": "ExperimentPresetRecord",
  "type": "object",
  "$id": "https://gamr.local/schemas/experiment.schema.json"
}
