{
  "$defs": {
    "ExperimentPresetConfig": {
      "additionalProperties": false,
      "properties": {
        "actionMode": {
          "default": "read_only",
          "pattern": "^(read_only|approval_required)$",
          "title": "Actionmode",
          "type": "string"
        },
        "model": {
          "default": "",
          "title": "Model",
          "type": "string"
        },
        "adversarialResearcherModel": {
          "default": "",
          "title": "Adversarialresearchermodel",
          "type": "string"
        },
        "judgeModel": {
          "default": "",
          "title": "Judgemodel",
          "type": "string"
        },
        "maxTurns": {
          "default": 40,
          "minimum": 1,
          "title": "Maxturns",
          "type": "integer"
        },
        "discoveryTurns": {
          "default": 20,
          "minimum": 1,
          "title": "Discoveryturns",
          "type": "integer"
        },
        "scenarioIds": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scenarioids"
        },
        "researchIterations": {
          "default": 0,
          "minimum": 0,
          "title": "Researchiterations",
          "type": "integer"
        },
        "historyTestRuns": {
          "default": 10,
          "maximum": 100,
          "minimum": 0,
          "title": "Historytestruns",
          "type": "integer"
        },
        "historyResearchRuns": {
          "default": 5,
          "maximum": 100,
          "minimum": 0,
          "title": "Historyresearchruns",
          "type": "integer"
        },
        "maxConcurrentScenarioExecutions": {
          "default": 5,
          "maximum": 5,
          "minimum": 1,
          "title": "Maxconcurrentscenarioexecutions",
          "type": "integer"
        }
      },
      "title": "ExperimentPresetConfig",
      "type": "object"
    },
    "ExperimentSource": {
      "enum": [
        "cli",
        "service"
      ],
      "title": "ExperimentSource",
      "type": "string"
    },
    "ExperimentState": {
      "enum": [
        "queued",
        "preparing",
        "discovering",
        "running",
        "waiting_for_approval",
        "evaluating",
        "reporting",
        "completed",
        "failed",
        "cancelled",
        "interrupted"
      ],
      "title": "ExperimentState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "default": "1.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Id",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/ExperimentSource",
      "default": "cli"
    },
    "experimentPresetId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Experimentpresetid"
    },
    "retryOf": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retryof"
    },
    "name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name"
    },
    "task": {
      "minLength": 1,
      "title": "Task",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/ExperimentState",
      "default": "queued"
    },
    "configuration": {
      "$ref": "#/$defs/ExperimentPresetConfig"
    },
    "resultPath": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resultpath"
    },
    "errorSummary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Errorsummary"
    },
    "createdAt": {
      "format": "date-time",
      "title": "Createdat",
      "type": "string"
    },
    "updatedAt": {
      "format": "date-time",
      "title": "Updatedat",
      "type": "string"
    },
    "finishedAt": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finishedat"
    }
  },
  "required": [
    "id",
    "task"
  ],
  "title": "ExperimentRecord",
  "type": "object",
  "$id": "https://gamr.local/schemas/run.schema.json"
}
