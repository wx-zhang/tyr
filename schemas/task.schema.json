{
  "$defs": {
    "DiscoveryPlan": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "default": "1.0",
          "title": "Schemaversion",
          "type": "string"
        },
        "kind": {
          "const": "discovery",
          "default": "discovery",
          "title": "Kind",
          "type": "string"
        },
        "prompt": {
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "outputFields": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Outputfields",
          "type": "array"
        }
      },
      "required": [
        "prompt"
      ],
      "title": "DiscoveryPlan",
      "type": "object"
    },
    "EvaluationPlan": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "default": "1.0",
          "title": "Schemaversion",
          "type": "string"
        },
        "kind": {
          "const": "evaluation",
          "default": "evaluation",
          "title": "Kind",
          "type": "string"
        },
        "prompt": {
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        }
      },
      "required": [
        "prompt"
      ],
      "title": "EvaluationPlan",
      "type": "object"
    },
    "PromptBundle": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "default": "1.0",
          "title": "Schemaversion",
          "type": "string"
        },
        "kind": {
          "const": "methodology",
          "default": "methodology",
          "title": "Kind",
          "type": "string"
        },
        "systemBrief": {
          "minLength": 1,
          "title": "Systembrief",
          "type": "string"
        },
        "unstickingGuidance": {
          "minLength": 1,
          "title": "Unstickingguidance",
          "type": "string"
        },
        "testingMethodology": {
          "minLength": 1,
          "title": "Testingmethodology",
          "type": "string"
        }
      },
      "required": [
        "systemBrief",
        "unstickingGuidance",
        "testingMethodology"
      ],
      "title": "PromptBundle",
      "type": "object"
    },
    "Scenario": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "default": "1.0",
          "title": "Schemaversion",
          "type": "string"
        },
        "kind": {
          "const": "scenario",
          "default": "scenario",
          "title": "Kind",
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/ScenarioMetadata"
        },
        "spec": {
          "$ref": "#/$defs/ScenarioSpec"
        }
      },
      "required": [
        "metadata",
        "spec"
      ],
      "title": "Scenario",
      "type": "object"
    },
    "ScenarioMetadata": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "category": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "title": "ScenarioMetadata",
      "type": "object"
    },
    "ScenarioSpec": {
      "additionalProperties": false,
      "properties": {
        "objective": {
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        },
        "steps": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "successCriteria": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Successcriteria"
        },
        "expectedControl": {
          "minLength": 1,
          "title": "Expectedcontrol",
          "type": "string"
        },
        "evidenceRequirements": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidencerequirements",
          "type": "array"
        },
        "collectorEvidence": {
          "anyOf": [
            {
              "enum": [
                "request",
                "file"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Collectorevidence"
        }
      },
      "required": [
        "objective",
        "steps",
        "expectedControl",
        "evidenceRequirements"
      ],
      "title": "ScenarioSpec",
      "type": "object"
    },
    "TaskDefaults": {
      "additionalProperties": false,
      "properties": {
        "maxTurns": {
          "minimum": 1,
          "title": "Maxturns",
          "type": "integer"
        },
        "actionMode": {
          "pattern": "^(read_only|approval_required)$",
          "title": "Actionmode",
          "type": "string"
        },
        "defaultCaseIds": {
          "items": {
            "type": "string"
          },
          "title": "Defaultcaseids",
          "type": "array"
        }
      },
      "required": [
        "maxTurns",
        "actionMode"
      ],
      "title": "TaskDefaults",
      "type": "object"
    },
    "TaskManifest": {
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "$Schema"
        },
        "schemaVersion": {
          "default": "1.0",
          "title": "Schemaversion",
          "type": "string"
        },
        "kind": {
          "const": "task",
          "default": "task",
          "title": "Kind",
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/TaskMetadata"
        },
        "spec": {
          "$ref": "#/$defs/TaskSpec"
        }
      },
      "required": [
        "metadata",
        "spec"
      ],
      "title": "TaskManifest",
      "type": "object"
    },
    "TaskMetadata": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "version"
      ],
      "title": "TaskMetadata",
      "type": "object"
    },
    "TaskSpec": {
      "additionalProperties": false,
      "properties": {
        "discovery": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Discovery"
        },
        "methodology": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Methodology"
        },
        "evaluation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evaluation"
        },
        "cases": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Cases",
          "type": "array"
        },
        "defaults": {
          "$ref": "#/$defs/TaskDefaults"
        },
        "variables": {
          "additionalProperties": {
            "$ref": "#/$defs/TaskVariable"
          },
          "title": "Variables",
          "type": "object"
        }
      },
      "required": [
        "cases",
        "defaults"
      ],
      "title": "TaskSpec",
      "type": "object"
    },
    "TaskVariable": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "run",
            "literal",
            "discovery"
          ],
          "title": "Source",
          "type": "string"
        },
        "default": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        }
      },
      "required": [
        "source"
      ],
      "title": "TaskVariable",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "discovery": "#/$defs/DiscoveryPlan",
      "evaluation": "#/$defs/EvaluationPlan",
      "methodology": "#/$defs/PromptBundle",
      "scenario": "#/$defs/Scenario",
      "task": "#/$defs/TaskManifest"
    },
    "propertyName": "kind"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/TaskManifest"
    },
    {
      "$ref": "#/$defs/DiscoveryPlan"
    },
    {
      "$ref": "#/$defs/PromptBundle"
    },
    {
      "$ref": "#/$defs/EvaluationPlan"
    },
    {
      "$ref": "#/$defs/Scenario"
    }
  ],
  "$id": "https://gamr.local/schemas/task.schema.json"
}
